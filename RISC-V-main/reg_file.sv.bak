module reg_file (
    output logic [31:0] rd1,
    output logic [31:0] rd2,
    input  logic [4:0]  rs1,
    input  logic [4:0]  rs2,
    input  logic [4:0]  rd,
    input  logic [31:0] wd,
    input  logic        regwrite,
    input  logic        clk
);
    logic [31:0] regs [0:31];

    initial begin
        for (int i = 0; i < 32; i++)
            regs[i] = '0;
    end

    assign rd1 = regs[rs1];
    assign rd2 = regs[rs2];

    always_ff @(posedge clk) begin
        if (regwrite && (rd != 5'd0))
            regs[rd] <= wd;
    end
endmodule

